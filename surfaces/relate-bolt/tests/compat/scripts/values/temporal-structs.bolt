# ADR-0325 (F-51..F-56, F-58; D-09..D-15, D-26..D-32): temporal results
# are the Bolt 4.4 PackStream structures Neo4j 2026.09.0 sends, never
# strings. AUTO HELLO negotiates no patch_bolt, so datetimes use the
# legacy 0x46/0x66 forms with local wall-clock seconds.
!: BOLT 4.4
!: AUTO HELLO
!: AUTO GOODBYE

C: RUN "RETURN date('2024-01-02') AS d, time('03:04:05.123456789+01:00') AS t, localtime('03:04:05.123456789') AS lt, datetime('2024-01-02T03:04:05.123456789+01:00') AS dt, datetime('2024-01-02T03:04:05[Europe/Stockholm]') AS zdt, localdatetime('2024-01-02T03:04:05.123456789') AS ldt, duration('P1Y2M3DT4H5M6.5S') AS dur" {} {}
   PULL {"n": -1}
S: SUCCESS {"fields": ["d", "t", "lt", "dt", "zdt", "ldt", "dur"]}
   RECORD [{"#44": [19724]}, {"#54": [11045123456789, 3600]}, {"#74": [11045123456789]}, {"#46": [1704164645, 123456789, 3600]}, {"#66": [1704164645, 0, "Europe/Stockholm"]}, {"#64": [1704164645, 123456789]}, {"#45": [14, 3, 14706, 500000000]}]
   SUCCESS {}

# A temporal parameter echoes back as the same structure.
C: RUN "RETURN $d AS d, $z AS z" {"d": {"#45": [14, 16, 12, 7]}, "z": {"#66": [469024274, 645876123, "Europe/Stockholm"]}} {}
   PULL {"n": -1}
S: SUCCESS {"fields": ["d", "z"]}
   RECORD [{"#45": [14, 16, 12, 7]}, {"#66": [469024274, 645876123, "Europe/Stockholm"]}]
   SUCCESS {}
