# Baseline B-22 (F-49): a one-hop path matched along its relationship
# encodes as the Bolt 4.4 Path structure 0x50 [nodes, unbound
# relationships 0x72 [id, type, properties], sequence], with the sequence
# [1, 1]. The graph is seeded by the first query. "*" is a wildcard only
# as a map value, not as a structure field, so the ids are pinned: they
# are the ones this script's own fresh :memory: server assigns.
!: BOLT 4.4
!: AUTO HELLO
!: AUTO GOODBYE

C: RUN "CREATE (a:BoltProbe {name: 'a', k: 1})-[:BOLT_PROBE {since: 2020}]->(b:BoltProbe {name: 'b'})" {} {}
   PULL {"n": -1}
S: SUCCESS {}
   SUCCESS {}

C: RUN "MATCH p = (:BoltProbe {name: 'a'})-[:BOLT_PROBE]->() RETURN p" {} {}
   PULL {"n": -1}
S: SUCCESS {}
   RECORD [{"#50": [[{"#4E": [0, ["BoltProbe"], {"k": 1, "name": "a"}]}, {"#4E": [1, ["BoltProbe"], {"name": "b"}]}], [{"#72": [0, "BOLT_PROBE", {"since": 2020}]}], [1, 1]]}]
   SUCCESS {}
