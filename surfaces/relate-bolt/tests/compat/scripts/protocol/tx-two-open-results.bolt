# ADR-0311 (F-23, F-24, D-41): every RUN in an explicit transaction keeps
# its own result under a qid; PULL {qid} addresses one, PULL without qid the
# most recent, and interleaved n = 1 pulls get each result its own rows.
!: BOLT 4.4
!: AUTO HELLO
!: AUTO GOODBYE

C: BEGIN {}
S: SUCCESS {}
C: RUN "UNWIND [1, 2] AS a RETURN a" {} {}
S: SUCCESS {"fields": ["a"], "qid": 0}
C: RUN "UNWIND [10, 20] AS b RETURN b" {} {}
S: SUCCESS {"fields": ["b"], "qid": 1}
C: PULL {"n": -1, "qid": 0}
S: RECORD [1]
   RECORD [2]
   SUCCESS {"type": "r", "t_last": "*", "db": "neo4j"}
C: PULL {"n": -1}
S: RECORD [10]
   RECORD [20]
   SUCCESS {"type": "r", "t_last": "*", "db": "neo4j"}

# One interleaved n = 1 round.
C: RUN "UNWIND [1, 2] AS c RETURN c" {} {}
S: SUCCESS {"fields": ["c"], "qid": 2}
C: RUN "UNWIND [10, 20] AS d RETURN d" {} {}
S: SUCCESS {"fields": ["d"], "qid": 3}
C: PULL {"n": 1, "qid": 2}
S: RECORD [1]
   SUCCESS {"has_more": true}
C: PULL {"n": 1, "qid": 3}
S: RECORD [10]
   SUCCESS {"has_more": true}
C: PULL {"n": 1, "qid": 2}
S: RECORD [2]
   SUCCESS {"type": "r"}
C: PULL {"n": 1, "qid": 3}
S: RECORD [20]
   SUCCESS {"type": "r"}
C: COMMIT
S: SUCCESS {}
